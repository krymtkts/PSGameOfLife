<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- NOTE: F# dependencies. -->
    <PackageVersion Include="FSharp.Core" Version="10.1.400" />
    <!-- NOTE: PowerShell dependencies. -->
    <PackageVersion Include="PowerShellStandard.Library" Version="7.0.0-preview.1" />
    <!-- NOTE: Avalonia dependencies. -->
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <!-- NOTE: to address Avalonia DBus issue -->
    <PackageVersion Include="Tmds.DBus.Protocol" Version="0.94.2" SecurityPin="true" />
    <!-- NOTE: Test dependencies. -->
    <PackageVersion Include="Expecto" Version="11.1.0" />
    <PackageVersion Include="YoloDev.Expecto.TestSdk" Version="0.16.0" />
    <!-- NOTE: Use HangDump on 2.x to match YoloDev.Expecto.TestSdk's MTP v2 line. -->
    <PackageVersion Include="Microsoft.Testing.Extensions.HangDump" Version="2.3.3" />
    <!-- NOTE: Analyzer configurations. -->
    <PackageVersion Include="Ionide.Analyzers" Version="0.16.0" />
  </ItemGroup>
</Project>